# ==================== 环境配置 ====================
# 运行环境: "local" (本地开发，使用内存数据库) | "production" (服务器部署，使用 MySQL)
ENVIRONMENT=local

# MySQL 数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=

# ==================== 向量数据库配置 ====================
# 向量数据库提供商: "milvus" | "chroma"
# milvus: 需要独立的 Milvus 服务，适合生产环境
# chroma: 轻量级，支持内存模式或本地持久化，适合开发测试
VECTOR_STORE_PROVIDER=chroma

# Milvus 配置（当 VECTOR_STORE_PROVIDER=milvus 时生效）
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=knowledge_base

# Chroma 配置（当 VECTOR_STORE_PROVIDER=chroma 时生效）
# 持久化目录，留空则使用纯内存模式（重启后数据丢失）
CHROMA_PERSIST_DIRECTORY=
CHROMA_COLLECTION=knowledge_base

# ==================== 模型提供商配置 ====================
# LLM 提供商: "ollama" | "longcat" | "deepseek"
LLM_PROVIDER=ollama
# Embedding 提供商: "ollama" | "longcat"（DeepSeek 不支持 Embedding）
# 例如：LLM_PROVIDER=deepseek + EMBEDDING_PROVIDER=ollama 表示 LLM 用云端 DeepSeek，Embedding 用本地 qwen3-embedding
EMBEDDING_PROVIDER=ollama

# 向后兼容：如果设置了 MODEL_PROVIDER，则同时应用于 LLM 和 Embedding
# MODEL_PROVIDER=ollama

# ==================== Ollama 模型配置 ====================
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=qwen3:4b
EMBEDDING_MODEL_NAME=qwen3-embedding:0.6b

# ==================== 美团 LongCat-2.0 模型配置 ====================
# 当 LLM_PROVIDER=longcat 或 EMBEDDING_PROVIDER=longcat 时生效
LONGCAT_BASE_URL=https://api.longcat.chat/openai
LONGCAT_API_KEY=your_api_key_here
LONGCAT_LLM_MODEL=LongCat-2.0-Chat
LONGCAT_EMBEDDING_MODEL=LongCat-Embedding

# ==================== DeepSeek 模型配置 ====================
# 当 LLM_PROVIDER=deepseek 时生效
# 注意：DeepSeek 仅支持 LLM，不支持 Embedding
# Embedding 请使用 ollama 或 longcat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_LLM_MODEL=deepseek-chat
