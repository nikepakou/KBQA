# ==================== 环境配置 ====================
# 运行环境: "local" (本地开发，使用内存数据库) | "production" (服务器部署，使用 MySQL)
ENVIRONMENT=production

# MySQL 数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=

# ==================== 模型提供商配置 ====================
# LLM 提供商: "ollama" | "longcat"
LLM_PROVIDER=ollama
# Embedding 提供商: "ollama" | "longcat"（可独立于 LLM 配置）
# 例如：LLM_PROVIDER=longcat + EMBEDDING_PROVIDER=ollama 表示 LLM 用云端 LongCat，Embedding 用本地 qwen3-embedding
EMBEDDING_PROVIDER=ollama

# 向后兼容：如果设置了 MODEL_PROVIDER，则同时应用于 LLM 和 Embedding
# MODEL_PROVIDER=ollama

# ==================== Ollama 模型配置 ====================
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=qwen3:4b
EMBEDDING_MODEL_NAME=qwen3-embedding:0.6b

# ==================== 美团 LongCat-2.0 模型配置 ====================
# 当 LLM_PROVIDER=longcat 或 EMBEDDING_PROVIDER=longcat 时生效
LONGCAT_BASE_URL=https://api.longcat.chat/openai
LONGCAT_API_KEY=your_api_key_here
LONGCAT_LLM_MODEL=LongCat-2.0-Chat
LONGCAT_EMBEDDING_MODEL=LongCat-Embedding
